{
	"name": "df_bronze_paradas_9887212",
	"properties": {
		"description": "Bronze: conserva filas y valores de CSV 2020-2021, Excel 2022/2023 y SQL 2024/2025. Homologa columnas; no elimina duplicados.",
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_paradas_csv",
						"type": "DatasetReference"
					},
					"name": "OrigenCSV"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "OrigenExcel2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2023_xls",
						"type": "DatasetReference"
					},
					"name": "OrigenExcel2023"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "OrigenSQL"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "bronze_paradas_dw",
						"type": "DatasetReference"
					},
					"name": "DestinoBronze"
				}
			],
			"transformations": [
				{
					"name": "MapeoCSV"
				},
				{
					"name": "ColumnasCSV"
				},
				{
					"name": "MapeoExcel2022"
				},
				{
					"name": "ColumnasExcel2022"
				},
				{
					"name": "MapeoExcel2023"
				},
				{
					"name": "ColumnasExcel2023"
				},
				{
					"name": "MapeoSQL"
				},
				{
					"name": "ColumnasSQL"
				},
				{
					"name": "UnirFuentes"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> OrigenCSV",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> OrigenExcel2022",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> OrigenExcel2023",
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_COMMITTED',",
				"     query: 'SELECT CONVERT(varchar(255), [AnioFuente]) AS [AnioFuente], CONVERT(varchar(255), [ParadaHistoricaId]) AS [ParadaHistoricaId], CONVERT(varchar(255), [CodigoPublicado]) AS [CodigoPublicado], CONVERT(varchar(255), [NombreParada]) AS [NombreParada], CONVERT(varchar(255), [Zona]) AS [Zona], CONVERT(varchar(255), [Latitud]) AS [Latitud], CONVERT(varchar(255), [Longitud]) AS [Longitud], CONVERT(varchar(255), [VigenciaDesde], 23) AS [VigenciaDesde], CONVERT(varchar(255), [VigenciaHasta], 23) AS [VigenciaHasta], CONVERT(varchar(255), [Estado]) AS [Estado] FROM dbo.ParadasAzure',",
				"     format: 'query') ~> OrigenSQL",
				"OrigenCSV derive(b_AnioFuente = '2020-2021',",
				"          b_ParadaHistoricaId = toString(nro_parada),",
				"          b_CodigoPublicado = toString(nro_parada),",
				"          b_NombreParada = toString(nombre_parada),",
				"          b_Zona = toString(zona),",
				"          b_Latitud = toString(latitud),",
				"          b_Longitud = toString(longitud),",
				"          b_VigenciaDesde = toString(fecha_desde),",
				"          b_VigenciaHasta = toString(fecha_hasta),",
				"          b_Estado = toString(estado)) ~> MapeoCSV",
				"MapeoCSV select(mapColumn(",
				"          AnioFuente = b_AnioFuente,",
				"          ParadaHistoricaId = b_ParadaHistoricaId,",
				"          CodigoPublicado = b_CodigoPublicado,",
				"          NombreParada = b_NombreParada,",
				"          Zona = b_Zona,",
				"          Latitud = b_Latitud,",
				"          Longitud = b_Longitud,",
				"          VigenciaDesde = b_VigenciaDesde,",
				"          VigenciaHasta = b_VigenciaHasta,",
				"          Estado = b_Estado",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasCSV",
				"OrigenExcel2022 derive(b_AnioFuente = '2022',",
				"          b_ParadaHistoricaId = toString(nro_parada),",
				"          b_CodigoPublicado = toString(nro_parada),",
				"          b_NombreParada = toString(nombre_parada),",
				"          b_Zona = toString(zona),",
				"          b_Latitud = toString(latitud),",
				"          b_Longitud = toString(longitud),",
				"          b_VigenciaDesde = toString(fecha_desde),",
				"          b_VigenciaHasta = toString(fecha_hasta),",
				"          b_Estado = toString(estado)) ~> MapeoExcel2022",
				"MapeoExcel2022 select(mapColumn(",
				"          AnioFuente = b_AnioFuente,",
				"          ParadaHistoricaId = b_ParadaHistoricaId,",
				"          CodigoPublicado = b_CodigoPublicado,",
				"          NombreParada = b_NombreParada,",
				"          Zona = b_Zona,",
				"          Latitud = b_Latitud,",
				"          Longitud = b_Longitud,",
				"          VigenciaDesde = b_VigenciaDesde,",
				"          VigenciaHasta = b_VigenciaHasta,",
				"          Estado = b_Estado",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasExcel2022",
				"OrigenExcel2023 derive(b_AnioFuente = '2023',",
				"          b_ParadaHistoricaId = toString(nro_parada),",
				"          b_CodigoPublicado = toString(nro_parada),",
				"          b_NombreParada = toString(nombre_parada),",
				"          b_Zona = toString(zona),",
				"          b_Latitud = toString(latitud),",
				"          b_Longitud = toString(longitud),",
				"          b_VigenciaDesde = toString(fecha_desde),",
				"          b_VigenciaHasta = toString(fecha_hasta),",
				"          b_Estado = toString(estado)) ~> MapeoExcel2023",
				"MapeoExcel2023 select(mapColumn(",
				"          AnioFuente = b_AnioFuente,",
				"          ParadaHistoricaId = b_ParadaHistoricaId,",
				"          CodigoPublicado = b_CodigoPublicado,",
				"          NombreParada = b_NombreParada,",
				"          Zona = b_Zona,",
				"          Latitud = b_Latitud,",
				"          Longitud = b_Longitud,",
				"          VigenciaDesde = b_VigenciaDesde,",
				"          VigenciaHasta = b_VigenciaHasta,",
				"          Estado = b_Estado",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasExcel2023",
				"OrigenSQL derive(b_AnioFuente = toString(AnioFuente),",
				"          b_ParadaHistoricaId = toString(ParadaHistoricaId),",
				"          b_CodigoPublicado = toString(CodigoPublicado),",
				"          b_NombreParada = toString(NombreParada),",
				"          b_Zona = toString(Zona),",
				"          b_Latitud = toString(Latitud),",
				"          b_Longitud = toString(Longitud),",
				"          b_VigenciaDesde = toString(VigenciaDesde),",
				"          b_VigenciaHasta = toString(VigenciaHasta),",
				"          b_Estado = toString(Estado)) ~> MapeoSQL",
				"MapeoSQL select(mapColumn(",
				"          AnioFuente = b_AnioFuente,",
				"          ParadaHistoricaId = b_ParadaHistoricaId,",
				"          CodigoPublicado = b_CodigoPublicado,",
				"          NombreParada = b_NombreParada,",
				"          Zona = b_Zona,",
				"          Latitud = b_Latitud,",
				"          Longitud = b_Longitud,",
				"          VigenciaDesde = b_VigenciaDesde,",
				"          VigenciaHasta = b_VigenciaHasta,",
				"          Estado = b_Estado",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasSQL",
				"ColumnasCSV, ColumnasExcel2022, ColumnasExcel2023, ColumnasSQL union(byName: true)~> UnirFuentes",
				"UnirFuentes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> DestinoBronze"
			]
		}
	}
}