{
	"name": "df_silver_vehiculos_9887212",
	"properties": {
		"description": "Silver: convierte fechas ISO, dd/MM/yyyy y seriales Excel, normaliza, valida, separa observados y elimina solo duplicados exactos. Expande el catalogo CSV 2020-2021 por anio y conserva vigencias.",
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_vehiculos_dw",
						"type": "DatasetReference"
					},
					"name": "OrigenBronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "DestinoSilver"
				},
				{
					"dataset": {
						"referenceName": "observados_vehiculos_dw",
						"type": "DatasetReference"
					},
					"name": "DestinoObservados"
				}
			],
			"transformations": [
				{
					"name": "Normalizar"
				},
				{
					"name": "Identificar"
				},
				{
					"name": "Validar"
				},
				{
					"name": "Clasificar"
				},
				{
					"name": "ColumnasSilver"
				},
				{
					"name": "QuitarDuplicadosExactos"
				},
				{
					"name": "ExplicarObservacion"
				},
				{
					"name": "ColumnasObservadas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_COMMITTED',",
				"     query: 'SELECT CONVERT(varchar(10), 2020) AS AnioFuente, [VehiculoId], [Placa], [TipoVehiculo], [CapacidadEfectiva], [VigenciaDesde], [VigenciaHasta], [Estado] FROM bronze.VehiculosAzure WHERE AnioFuente = \\'2020-2021\\' UNION ALL SELECT CONVERT(varchar(10), 2021) AS AnioFuente, [VehiculoId], [Placa], [TipoVehiculo], [CapacidadEfectiva], [VigenciaDesde], [VigenciaHasta], [Estado] FROM bronze.VehiculosAzure WHERE AnioFuente = \\'2020-2021\\' UNION ALL SELECT AnioFuente, [VehiculoId], [Placa], [TipoVehiculo], [CapacidadEfectiva], [VigenciaDesde], [VigenciaHasta], [Estado] FROM bronze.VehiculosAzure WHERE (AnioFuente <> \\'2020-2021\\' OR AnioFuente IS NULL)',",
				"     format: 'query') ~> OrigenBronze",
				"OrigenBronze derive(nAnio = toInteger(trim(AnioFuente)),",
				"          nDesde = coalesce(toDate(substring(trim(VigenciaDesde), 1, 10), 'yyyy-MM-dd'), toDate(trim(VigenciaDesde), 'dd/MM/yyyy'), addDays(toDate('1899-12-30'), toInteger(toDouble(VigenciaDesde)))),",
				"          nHasta = coalesce(toDate(substring(trim(VigenciaHasta), 1, 10), 'yyyy-MM-dd'), toDate(trim(VigenciaHasta), 'dd/MM/yyyy'), addDays(toDate('1899-12-30'), toInteger(toDouble(VigenciaHasta)))),",
				"          nEstado = upper(trim(Estado)),",
				"          nNumero = toInteger(replace(upper(trim(VehiculoId)), 'V-', '')),",
				"          nPlaca = upper(trim(Placa)),",
				"          nTipo = upper(trim(TipoVehiculo)),",
				"          nCapacidad = toInteger(trim(CapacidadEfectiva))) ~> Normalizar",
				"Normalizar derive(nId = iif(isNull(nNumero), toString(null()), concat('V-', lpad(toString(nNumero), 3, '0')))) ~> Identificar",
				"Identificar derive(nValido = coalesce(!isNull(nCapacidad) && nCapacidad > 0 && nNumero > 0 && nNumero <= 999 && !isNull(nAnio) && nAnio >= 2020 && nAnio <= 2025 && !isNull(nDesde) && !isNull(nHasta) && nDesde <= nHasta && year(nDesde) <= nAnio && year(nHasta) >= nAnio && !isNull(nId) && length(nId) > 0 && length(nId) <= 20 && !isNull(nPlaca) && length(nPlaca) > 0 && length(nPlaca) <= 20 && !isNull(nTipo) && length(nTipo) > 0 && length(nTipo) <= 30 && !isNull(nEstado) && length(nEstado) > 0 && length(nEstado) <= 20, false())) ~> Validar",
				"Validar split(nValido,",
				"     disjoint: false) ~> Clasificar@(Validos, Observados)",
				"Clasificar@Validos select(mapColumn(",
				"          AnioFuente = nAnio,",
				"          VehiculoId = nId,",
				"          Placa = nPlaca,",
				"          TipoVehiculo = nTipo,",
				"          CapacidadEfectiva = nCapacidad,",
				"          VigenciaDesde = nDesde,",
				"          VigenciaHasta = nHasta,",
				"          Estado = nEstado",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasSilver",
				"ColumnasSilver aggregate(groupBy(AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado),",
				"     Repeticiones = count()) ~> QuitarDuplicadosExactos",
				"Clasificar@Observados derive(Motivo = iif(isNull(nDesde) || isNull(nHasta), 'FECHA_INVALIDA', iif(year(nDesde) > nAnio || year(nHasta) < nAnio || nDesde > nHasta, 'FUERA_DE_VIGENCIA_O_INTERVALO_INVALIDO', 'CAMPO_REQUERIDO_TIPO_LONGITUD_O_RANGO_INVALIDO'))) ~> ExplicarObservacion",
				"ExplicarObservacion select(mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado,",
				"          Motivo",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasObservadas",
				"QuitarDuplicadosExactos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> DestinoSilver",
				"ColumnasObservadas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string,",
				"          Motivo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado,",
				"          Motivo",
				"     )) ~> DestinoObservados"
			]
		}
	}
}