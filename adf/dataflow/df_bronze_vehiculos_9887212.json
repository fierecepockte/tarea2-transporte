                                                                  "    errorHandlingOption: \u0027stopOnFirstError\u0027,",
                                                                  "    mapColumn(AnioFuente, VehiculoId, Placa, TipoVehiculo, CapacidadEfectiva, VigenciaDesde, VigenciaHasta, Estado)) ~\u003e DestinoBronze"
                                                              ]
                                          }
