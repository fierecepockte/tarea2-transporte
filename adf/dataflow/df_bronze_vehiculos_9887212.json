                                                                  "ColumnasCSV, ColumnasExcel2022, ColumnasExcel2023, ColumnasSQL union(byName: true) ~\u003e UnirFuentes",
                                                                  "UnirFuentes sink(input(AnioFuente as string, VehiculoId as string, Placa as string, TipoVehiculo as string, CapacidadEfectiva as string, VigenciaDesde as string, VigenciaHasta as string, Estado as string),",
