                                                                  "    VigenciaHasta = b_VigenciaHasta,",
                                                                  "    Estado = b_Estado),",
                                                                  "    skipDuplicateMapInputs: false, skipDuplicateMapOutputs: true) ~\u003e ColumnasExcel2023",
                                                                  "source(output(AnioFuente as string, VehiculoId as string, Placa as string, TipoVehiculo as string, CapacidadEfectiva as string, VigenciaDesde as string, VigenciaHasta as string, Estado as string),",
                                                                  "    allowSchemaDrift: false,",
                                                                  "    validateSchema: false,",
                                                                  "    isolationLevel: \u0027READ_COMMITTED\u0027,",
                                                                  "    query: \u0027SELECT CONVERT(varchar(255), [AnioFuente]) AS [AnioFuente], CONVERT(varchar(255), [VehiculoId]) AS [VehiculoId], CONVERT(varchar(255), [Placa]) AS [Placa], CONVERT(varchar(255), [TipoVehiculo]) AS [TipoVehiculo], CONVERT(varchar(255), [CapacidadEfectiva]) AS [CapacidadEfectiva], CONVERT(varchar(255), [VigenciaDesde], 23) AS [VigenciaDesde], CONVERT(varchar(255), [VigenciaHasta], 23) AS [VigenciaHasta], CONVERT(varchar(255), [Estado]) AS [Estado] FROM dbo.VehiculosAzure\u0027,",
