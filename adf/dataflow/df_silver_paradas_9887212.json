{
	"name": "df_silver_paradas_9887212",
	"properties": {
		"description": "Silver: convierte fechas ISO, dd/MM/yyyy y seriales Excel, normaliza, valida, separa observados y elimina solo duplicados exactos. Expande el catalogo CSV 2020-2021 por anio y conserva vigencias. Para archivos sin ID historico: codigo@yyyyMMdd; mantiene separadas las dos ubicaciones de MC-01 de 2023. IDs del ERP conservados.",
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_paradas_dw",
						"type": "DatasetReference"
					},
					"name": "OrigenBronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "DestinoSilver"
				},
				{
					"dataset": {
						"referenceName": "observados_paradas_dw",
						"type": "DatasetReference"
					},
					"name": "DestinoObservados"
				}
			],
			"transformations": [
				{
					"name": "Normalizar"
				},
				{
					"name": "Identificar"
				},
				{
					"name": "Validar"
				},
				{
					"name": "Clasificar"
				},
				{
					"name": "ColumnasSilver"
				},
				{
					"name": "QuitarDuplicadosExactos"
				},
				{
					"name": "ExplicarObservacion"
				},
				{
					"name": "ColumnasObservadas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_COMMITTED',",
				"     query: 'SELECT CONVERT(varchar(10), 2020) AS AnioFuente, [ParadaHistoricaId], [CodigoPublicado], [NombreParada], [Zona], [Latitud], [Longitud], [VigenciaDesde], [VigenciaHasta], [Estado] FROM bronze.ParadasAzure WHERE AnioFuente = \\'2020-2021\\' UNION ALL SELECT CONVERT(varchar(10), 2021) AS AnioFuente, [ParadaHistoricaId], [CodigoPublicado], [NombreParada], [Zona], [Latitud], [Longitud], [VigenciaDesde], [VigenciaHasta], [Estado] FROM bronze.ParadasAzure WHERE AnioFuente = \\'2020-2021\\' UNION ALL SELECT AnioFuente, [ParadaHistoricaId], [CodigoPublicado], [NombreParada], [Zona], [Latitud], [Longitud], [VigenciaDesde], [VigenciaHasta], [Estado] FROM bronze.ParadasAzure WHERE (AnioFuente <> \\'2020-2021\\' OR AnioFuente IS NULL)',",
				"     format: 'query') ~> OrigenBronze",
				"OrigenBronze derive(nAnio = toInteger(trim(AnioFuente)),",
				"          nDesde = coalesce(toDate(substring(trim(VigenciaDesde), 1, 10), 'yyyy-MM-dd'), toDate(trim(VigenciaDesde), 'dd/MM/yyyy'), addDays(toDate('1899-12-30'), toInteger(toDouble(VigenciaDesde)))),",
				"          nHasta = coalesce(toDate(substring(trim(VigenciaHasta), 1, 10), 'yyyy-MM-dd'), toDate(trim(VigenciaHasta), 'dd/MM/yyyy'), addDays(toDate('1899-12-30'), toInteger(toDouble(VigenciaHasta)))),",
				"          nEstado = upper(trim(Estado)),",
				"          nCodigo = upper(trim(CodigoPublicado)),",
				"          nNombre = trim(NombreParada),",
				"          nZona = trim(Zona),",
				"          nLatitud = toDecimal(replace(trim(Latitud), ',', '.'), 9, 6),",
				"          nLongitud = toDecimal(replace(trim(Longitud), ',', '.'), 9, 6)) ~> Normalizar",
				"Normalizar derive(nId = iif(nAnio <= 2023, concat(nCodigo, '@', toString(nDesde, 'yyyyMMdd')), upper(trim(ParadaHistoricaId)))) ~> Identificar",
				"Identificar derive(nValido = coalesce(!isNull(nLatitud) && !isNull(nLongitud) && nLatitud >= -90 && nLatitud <= 90 && nLongitud >= -180 && nLongitud <= 180 && !isNull(nAnio) && nAnio >= 2020 && nAnio <= 2025 && !isNull(nDesde) && !isNull(nHasta) && nDesde <= nHasta && year(nDesde) <= nAnio && year(nHasta) >= nAnio && !isNull(nId) && length(nId) > 0 && length(nId) <= 30 && !isNull(nCodigo) && length(nCodigo) > 0 && length(nCodigo) <= 20 && !isNull(nNombre) && length(nNombre) > 0 && length(nNombre) <= 120 && !isNull(nZona) && length(nZona) > 0 && length(nZona) <= 40 && !isNull(nEstado) && length(nEstado) > 0 && length(nEstado) <= 20, false())) ~> Validar",
				"Validar split(nValido,",
				"     disjoint: false) ~> Clasificar@(Validos, Observados)",
				"Clasificar@Validos select(mapColumn(",
				"          AnioFuente = nAnio,",
				"          ParadaHistoricaId = nId,",
				"          CodigoPublicado = nCodigo,",
				"          NombreParada = nNombre,",
				"          Zona = nZona,",
				"          Latitud = nLatitud,",
				"          Longitud = nLongitud,",
				"          VigenciaDesde = nDesde,",
				"          VigenciaHasta = nHasta,",
				"          Estado = nEstado",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasSilver",
				"ColumnasSilver aggregate(groupBy(AnioFuente,",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado),",
				"     Repeticiones = count()) ~> QuitarDuplicadosExactos",
				"Clasificar@Observados derive(Motivo = iif(isNull(nDesde) || isNull(nHasta), 'FECHA_INVALIDA', iif(year(nDesde) > nAnio || year(nHasta) < nAnio || nDesde > nHasta, 'FUERA_DE_VIGENCIA_O_INTERVALO_INVALIDO', 'CAMPO_REQUERIDO_TIPO_LONGITUD_O_RANGO_INVALIDO'))) ~> ExplicarObservacion",
				"ExplicarObservacion select(mapColumn(",
				"          AnioFuente,",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado,",
				"          Motivo",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasObservadas",
				"QuitarDuplicadosExactos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> DestinoSilver",
				"ColumnasObservadas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string,",
				"          Motivo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado,",
				"          Motivo",
				"     )) ~> DestinoObservados"
			]
		}
	}
}